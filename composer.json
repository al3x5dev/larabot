{
    "name": "mk4u/larabot",
    "description": "Laravel integration for TGram library",
    "keywords": [
        "laravel",
        "tgram",
        "telegram",
        "bot"
    ],
    "type": "library",
    "require": {
        "php": ">=8.5",
        "mk4u/tgram": "^0.1",
        "al3x5/laravel-psr16-cache": "^1.0",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mk4U\\LaraBot\\": "src/"
        }
    },
    "authors": [
        {
            "name": "al3x5dev",
            "email": "al3x5.dev@gmail.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Mk4U\\LaraBot\\BotServiceProvider"
            ]
        }
    }
}